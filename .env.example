# Copiar a .env y completar localmente.
# No versionar este archivo con valores reales.

# Entorno
APP_ENVIRONMENT=development

# Base de datos
POSTGRES_DB=wabogados
POSTGRES_USER=wabogados
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://wabogados:local-development-only@localhost:5432/wabogados

# Seguridad
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Rate limiting
# Contador compartido del limitador. Vacío = limitador en memoria, que solo es
# correcto con UN solo proceso de API: con varios workers cada uno lleva su
# cuenta, así que el presupuesto real es `límite × workers`, y un reinicio se lo
# devuelve limpio a todos. Es la migración obligatoria de ADR-008.
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
MESSAGE_RATE_LIMIT_REQUESTS=30
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
# Formulario público de consulta. Es la única escritura sin credenciales de la
# aplicación y lo que acepta es el problema legal de una persona, así que su
# presupuesto es el más bajo: tres envíos por IP y por hora. Subirlo sube lo que
# cuesta inundar la cola de entrada.
CONTACT_RATE_LIMIT_REQUESTS=3
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# Almacenamiento de documentos (Fase 6)
# La ruta local solo aplica fuera de Docker; en Docker usa el volumen `storage_data`.
STORAGE_ROOT=.tmp/storage
MAX_UPLOAD_BYTES=20971520

# Biblioteca multimedia. Un vídeo útil no cabe en una captura de pantalla, así
# que la biblioteca lleva su propio tope en vez de levantar el de los documentos:
# un techo compartido solo puede estar mal para uno de los dos. Por encima del
# tope la subida se rechaza con 413: el archivo grande pertenece a la cola del
# worker (ADR-049), que todavía no existe.
MAX_MEDIA_BYTES=524288000

# Backend de almacenamiento: local | s3
STORAGE_BACKEND=local

# S3 / MinIO. Las credenciales NUNCA se versionan con valores reales.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=wabogados
S3_SECRET_KEY=local-development-only
S3_REGION=us-east-1
S3_BUCKET=wabogados-documents
S3_USE_SSL=false
# path funciona con MinIO; virtual es lo habitual en AWS S3.
S3_ADDRESSING_STYLE=path
# Crear el bucket al arrancar. Útil en desarrollo, no en producción.
S3_CREATE_BUCKET=true
# Debe seguir siendo legible de inmediato: GLACIER deja el objeto inaccesible
# hasta restaurarlo y el constructor lo rechaza.
S3_ARCHIVE_STORAGE_CLASS=STANDARD_IA

# Retención de versiones: solo mueve de tier, nunca elimina contenido.
RETENTION_HOT_DAYS=90
RETENTION_TIERING_ENABLED=true

# MinIO (servicio local de objetos)
MINIO_ROOT_USER=wabogados
MINIO_ROOT_PASSWORD=local-development-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Respaldo externo (Fase 6, MASTER_PROMPT 44) ---
# Una copia que sigue en el mismo host no protege de nada. El endpoint DEBE
# estar en otra máquina o proveedor. En `compose.yaml` el destino por defecto es
# un segundo servicio del mismo host: sirve para ejercitar el mecanismo, NO para
# sobrevivir a un incendio.
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_ENDPOINT=http://minio-backup:9000
BACKUP_REMOTE_ACCESS_KEY=backup-user
BACKUP_REMOTE_SECRET_KEY=local-development-only
BACKUP_REMOTE_BUCKET=wabogados-backups
BACKUP_REMOTE_PREFIX=wabogados
BACKUP_REMOTE_REGION=us-east-1
BACKUP_REMOTE_USE_SSL=false
BACKUP_REMOTE_ADDRESSING_STYLE=path
# Releer el objeto tras subirlo y comparar el SHA-256. Bajarlo a false es más
# rápido y menos seguro: solo se confían los metadatos.
BACKUP_REMOTE_VERIFY_UPLOAD=true
BACKUP_REMOTE_KEEP=90
MINIO_BACKUP_PORT=9100
MINIO_BACKUP_CONSOLE_PORT=9101

# Retención local de respaldos en disco
BACKUP_ROOT=backups
BACKUP_KEEP=30

# Administrador inicial (solo para `python -m app.cli.create_admin`).
# Nunca se exponen por la API. Usar un correo de dominio válido.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar-por-una-clave-fuerte

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000
API_INTERNAL_URL=http://localhost:8000