# Agent workspace / secrets
.env
.env.*
!.env.example
.tmp/
logs/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/htmlcov/
backend/.coverage
backend/.coverage.*
frontend/node_modules/
frontend/.next/
# Playwright: the saved session carries real cookies and the failure artefacts
# are per run. Neither belongs in version control.
frontend/e2e/.auth.json
frontend/test-results/
frontend/playwright-report/
credentials.json
token.json

# --- Added 2026-10-06, the day git was initialised ---------------------------
#
# The entries above predate version control being turned on and were written by
# feel. The ones below were found by actually looking at what is on disk.

# A real database dump. `postgres.dump` holds client data, and a dump in the
# history cannot be un-committed afterwards. Restoring is exercised with
# scripts/backup.sh against a throwaway database, not by versioning the dump.
backups/

# Playwright accessibility snapshots: they transcribe the rendered page, which
# means real names of real people from the sample cases ("Elena Vela"). Same
# reason as frontend/e2e/.auth.json above.
.playwright-mcp/

# Case material: photographs named after the people in them. Client material
# does not belong in the repository even when the repository is local.
WABOGADOS_recursos/

# Local environments. Only .env.example is meant to be read by a human.
.venv/
venv/
.opencode/node_modules/

# TypeScript incremental build cache. Regenerated by `tsc`, and it changes on
# every build, so committing it produces diffs nobody can read.
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# Stray artefacta: a 21-byte file whose entire content is the path
# ".tmp\e2e-password.txt", written by an e2e run that lost its argument.
E2e-*
